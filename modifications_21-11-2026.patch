diff --git a/styles.css b/styles.css
index c6e447b..2952e91 100644
--- a/styles.css
+++ b/styles.css
@@ -333,9 +333,40 @@ button { cursor: pointer; border: 0; background: none; color: inherit; }
 
 /* ---------- Suivi du jour ---------- */
 
-.track-card { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 15px 16px; }
+.track-card { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 15px 16px; position: relative; overflow: hidden; transition: border-color .35s, box-shadow .35s; }
 .track-card__q { font-size: 12px; font-weight: 600; line-height: 1.4; }
 .track-card__date { font-size: 9px; color: var(--violet-soft); font-weight: 800; margin-bottom: 5px; letter-spacing: .16em; }
+
+/* Série de jours consécutifs */
+.streak-badge { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; font-size: 9.5px; font-weight: 700; color: #FF6A5A; letter-spacing: .02em; }
+.streak-badge b { color: #fff; font-weight: 800; }
+.streak-badge svg { filter: drop-shadow(0 0 7px rgba(227,6,19,.85)); }
+
+/* Animation de feu à la validation */
+.track-card.fire-active { border-color: rgba(227,6,19,.6); box-shadow: 0 0 0 1px rgba(227,6,19,.22), 0 0 40px rgba(227,6,19,.35), var(--shadow-sm), inset 0 1px 0 rgba(255,255,255,.07); }
+.track-card.fire-active::before {
+  content: "";
+  position: absolute; inset: 0;
+  background: radial-gradient(circle at 82% 55%, rgba(227,6,19,.30), transparent 62%);
+  pointer-events: none;
+  animation: fireGlow 1.25s ease-out both;
+}
+@keyframes fireGlow { 0% { opacity: 0; } 28% { opacity: 1; } 100% { opacity: 0; } }
+
+.fire-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 2; }
+.fire-layer i {
+  position: absolute; bottom: 6px; left: var(--x);
+  width: var(--s); height: calc(var(--s) * 1.7);
+  background: radial-gradient(ellipse at 50% 82%, #FFE9D6 0%, #FF8A4D 32%, #E30613 70%, transparent 100%);
+  border-radius: 50% 50% 45% 45% / 62% 62% 38% 38%;
+  animation: fireRise 1.35s var(--d) cubic-bezier(.2,.7,.3,1) both;
+  filter: blur(.3px);
+}
+@keyframes fireRise {
+  0%   { transform: translateY(0) scale(.55) rotate(0deg); opacity: 0; }
+  18%  { opacity: 1; }
+  100% { transform: translateY(-118px) scale(1.35) rotate(20deg); opacity: 0; }
+}
 .yesno { display: flex; gap: 6px; }
 .yesno button {
   min-width: 46px; height: 33px; border-radius: 11px;
